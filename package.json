{
  "name": "silkroad-tours",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "node scripts/db.mjs migrate && next start",
    "typecheck": "tsc --noEmit",
    "db:seed:build": "tsx scripts/build-seed-sql.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "python3 scripts/check-schema-parity.py",
    "test:unit": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "setup:codespace": "bash scripts/codespace-setup.sh",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "npm run db:seed:build && node scripts/db.mjs seed",
    "db:seed:force": "tsx scripts/build-seed-sql.ts --reset && node scripts/db.mjs seed --force",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "rm -f data/silkroad.db* && npm run db:migrate && npm run db:seed",
    "db:backup": "node scripts/db.mjs backup",
    "db:prune": "node scripts/db.mjs prune",
    "ai:eval": "node scripts/ai-eval.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f --tail 100 app"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/noto-serif-display": "^5.3.0",
    "@hookform/resolvers": "^5.2.1",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "next": "15.5.29",
    "next-intl": "^4.3.5",
    "react": "19.1.10",
    "react-day-picker": "^9.9.0",
    "react-dom": "19.1.10",
    "react-hook-form": "^7.62.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
