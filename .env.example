# ─────────────────────────────────────────────────────────────────────────
# Silk Road Tours — environment. Copy to `.env` (Docker / production) or
# `.env.local` (npm run dev). Never commit real values: .env* is gitignored.
# ─────────────────────────────────────────────────────────────────────────

# ── Site ──
SITE_URL=https://silkroadtours.uz
# Build-time (inlined into the browser bundle by `next build`; passed as Docker build args)
NEXT_PUBLIC_SITE_URL=https://silkroadtours.uz
# Cloudflare Turnstile spam protection for the booking/review/service forms (free: dash.cloudflare.com → Turnstile).
# The values below are Cloudflare's public always-pass TEST keys: forms work, but there is no bot protection.
# Replace both with real keys before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
DEFAULT_CURRENCY=USD
BOOKING_REF_PREFIX=SRT

# ── Database (SQLite via libSQL; Docker stores it on the `app-data` volume) ──
# DATABASE_URL=file:./data/silkroad.db      (local dev default)
# DATABASE_URL=file:/data/silkroad.db       (set by docker-compose.yml)

# ── Security (generate: openssl rand -base64 48) ──
SESSION_SECRET=
# Used once to create the first owner account via POST /api/admin/auth/bootstrap (see docs/DEPLOYMENT.md).
ADMIN_SECRET=
# Set to true only if the site is served through Cloudflare's proxy.
TRUST_CF_CONNECTING_IP=false

# ── Telegram notifications for new booking requests (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI assistant & trip planner (server-side only; keys never reach the browser) ──
# Providers: gemini | groq | mock. With no key configured the site answers from the database only.
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-lite-latest
# Second model on the same provider for "high demand" errors; "none" disables it.
AI_SECONDARY_MODEL=gemini-flash-latest
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GROQ_API_KEY=
