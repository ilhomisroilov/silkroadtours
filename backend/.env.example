# Copy to .env ON THE SERVER ONLY (chmod 600). Never commit .env. Generate secrets with: openssl rand -hex 32
NT_ENV=staging
NT_SITE_URL=https://gulistantravel.uz
POSTGRES_PASSWORD=
API_PORT=3101

# Encrypts staff two-step verification secrets. Generate once and keep it (losing it means staff set up 2FA again):
#   docker compose run --rm api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NT_SECRET_KEY=

# Payme Merchant API: cashbox id and key from the Payme business cabinet (test key while on staging)
NT_PAYME_MERCHANT_ID=
NT_PAYME_KEY=

# Click SHOP API: from the Click merchant cabinet
NT_CLICK_SERVICE_ID=
NT_CLICK_MERCHANT_ID=
NT_CLICK_SECRET_KEY=

# Deposit taken at booking (percent of the total) and how long unpaid seats are held (minutes)
NT_DEPOSIT_PERCENT=30
NT_BOOKING_HOLD_MINUTES=30

# Email via Google Workspace: create the mailbox no-reply@gulistantravel.uz, turn on 2-Step Verification for it,
# then Google Account > Security > App passwords. Put the 16-character app password here (never the real password).
NT_MAIL_FROM=no-reply@gulistantravel.uz
NT_MAIL_REPLY_TO=info@gulistantravel.uz
NT_SMTP_USERNAME=no-reply@gulistantravel.uz
NT_SMTP_PASSWORD=

# Accounts. The API's public address is used for the Google/Facebook redirect URIs:
#   https://<NT_API_URL>/v1/auth/google/callback   and   .../v1/auth/facebook/callback
NT_API_URL=https://api.gulistantravel.uz
NT_COOKIE_DOMAIN=.gulistantravel.uz
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
NT_GOOGLE_CLIENT_ID=
NT_GOOGLE_CLIENT_SECRET=
# Meta for Developers > your app > Facebook Login
NT_FACEBOOK_APP_ID=
NT_FACEBOOK_APP_SECRET=
# @BotFather: /newbot, then /setdomain gulistantravel.uz
NT_TELEGRAM_BOT_TOKEN=
NT_TELEGRAM_BOT_USERNAME=
