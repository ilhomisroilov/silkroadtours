# Copy to .env ON THE SERVER ONLY (chmod 600). Never commit .env. Generate secrets with: openssl rand -hex 32
NT_ENV=staging
NT_SITE_URL=https://nationaltours.uz
POSTGRES_PASSWORD=
API_PORT=3101

# Payme Merchant API: cashbox id and key from the Payme business cabinet (test key while on staging)
NT_PAYME_MERCHANT_ID=
NT_PAYME_KEY=

# Click SHOP API: from the Click merchant cabinet
NT_CLICK_SERVICE_ID=
NT_CLICK_MERCHANT_ID=
NT_CLICK_SECRET_KEY=

# Deposit taken at booking (percent of the total) and how long unpaid seats are held (minutes)
NT_DEPOSIT_PERCENT=30
NT_BOOKING_HOLD_MINUTES=30

# Accounts. The API's public address is used for the Google/Facebook redirect URIs:
#   https://<NT_API_URL>/v1/auth/google/callback   and   .../v1/auth/facebook/callback
NT_API_URL=https://api.nationaltours.uz
NT_COOKIE_DOMAIN=.nationaltours.uz
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
NT_GOOGLE_CLIENT_ID=
NT_GOOGLE_CLIENT_SECRET=
# Meta for Developers > your app > Facebook Login
NT_FACEBOOK_APP_ID=
NT_FACEBOOK_APP_SECRET=
# @BotFather: /newbot, then /setdomain nationaltours.uz
NT_TELEGRAM_BOT_TOKEN=
NT_TELEGRAM_BOT_USERNAME=
